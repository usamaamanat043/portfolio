# Copy to .env.local. Without a key, the chatbot demo uses scripted replies.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# Contact form (https://resend.com): API key, plus optional sender and recipient
RESEND_API_KEY= 
# Optional. Defaults to Portfolio <onboarding@resend.dev>, which can only send to your own Resend account email until you verify a domain
CONTACT_FROM=
# Optional. Defaults to the email in lib/data.js
CONTACT_TO=
